/* =====================================================
   UTILITIES
===================================================== */

function pad(number) {
    return number < 10 ? "0" + number : number;
}

function formatDate(date) {
    return pad(date.getHours()) + ":" + pad(date.getMinutes()) + ":" + pad(date.getSeconds());
}

function calculateDuration(start, end) {

    if (!start || !end) { return "-"; }

    var seconds = Math.floor((end.getTime() - start.getTime()) / 1000);
    var minutes = Math.floor(seconds / 60);

    seconds = seconds % 60;

    return minutes + "m " + seconds + "s";
}

function formatBytes(bytes) {

    if (bytes === 0) { return "0 Bytes"; }

    var units = ["Bytes", "KB", "MB", "GB"];
    var index = Math.floor(Math.log(bytes) / Math.log(1024));

    return Math.round(bytes / Math.pow(1024, index) * 100) / 100 + " " + units[index];
}

function escapeHTML(text) {
    return String(text)
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}


/* =====================================================
   SUBWAY MAP
===================================================== */

var subwayRoot = null;
var subwayNodes = [];
var subwayEnd = 0;
var subwayMaxLane = 0;
var subwayTimer = null;

var SW_COLORS = ["#2563eb", "#dc2626", "#16a34a", "#f59e0b",
                 "#9333ea", "#0891b2", "#db2777", "#65a30d"];
var SW_XS = 130;     /* horizontal distance between stations */
var SW_LH = 110;     /* vertical distance between lines */
var SW_PADX = 70;
var SW_PADY = 70;


/* ---------- strip comments and string contents (keeps length) ---------- */

function stripCode(line) {
    var out = "";
    var inStr = false;
    var c;
    for (var i = 0; i < line.length; i++) {
        c = line.charAt(i);
        if (inStr) {
            if (c === '"') {
                if (line.charAt(i + 1) === '"') { out += "  "; i++; continue; }
                inStr = false;
            }
            out += " ";
            continue;
        }
        if (c === '"') { inStr = true; out += " "; continue; }
        if (c === "'") {
            out += new Array(line.length - i + 1).join(" ");
            break;
        }
        out += c;
    }
    if (/^\s*Rem\b/i.test(out)) {
        return out.replace(/./g, " ");
    }
    return out;
}


/* ---------- detect which macros each macro calls ---------- */

function analyzeCalls() {

    var byName = {};
    var modules = {};
    var i, j, k;

    for (i = 0; i < macros.length; i++) {
        var key = macros[i].name.toLowerCase();
        if (!byName[key]) { byName[key] = []; }
        byName[key].push(macros[i]);
        modules[macros[i].module.toLowerCase()] = true;
        macros[i].calls = [];
        macros[i].calledBy = [];
    }

    for (i = 0; i < macros.length; i++) {

        var m = macros[i];
        var seen = {};
        var lines = String(m.body || "").split(/\r?\n/);
        var sigSkipped = false;
        var sigRegex = new RegExp("\\b(Sub|Function)\\s+" + m.name + "\\b", "i");

        for (j = 0; j < lines.length; j++) {

            var raw = lines[j];

            if (!sigSkipped && sigRegex.test(raw)) {
                sigSkipped = true;
                continue;
            }

            var clean = stripCode(raw);

            if (/^\s*(Dim|Const|Static|Declare|End\s+(Sub|Function))\b/i.test(clean)) {
                continue;
            }

            var events = [];
            var mt;

            /* Application.Run "MacroName" */
            var runRegex = /Application\.Run\s*\(?\s*"([^"]+)"/ig;
            while ((mt = runRegex.exec(raw)) !== null) {
                var t = mt[1];
                t = t.substr(t.lastIndexOf("!") + 1);
                t = t.substr(t.lastIndexOf(".") + 1);
                events.push({ pos: mt.index, name: t });
            }

            /* Call MacroName / MacroName args / Module.MacroName */
            var idRegex = /[A-Za-z_][A-Za-z0-9_]*/g;
            while ((mt = idRegex.exec(clean)) !== null) {

                var id = mt[0];
                var p = mt.index;
                var lower = id.toLowerCase();

                if (!byName[lower]) { continue; }

                var before = clean.substr(0, p).replace(/\s+$/, "");

                if (before.charAt(before.length - 1) === ".") {
                    var pm = /([A-Za-z_][A-Za-z0-9_]*)$/.exec(before.substr(0, before.length - 1));
                    if (!(pm && modules[pm[1].toLowerCase()])) { continue; }
                }

                /* Function return assignment:  MyFunc = value */
                if (lower === m.name.toLowerCase() &&
                    /^\s*=/.test(clean.substr(p + id.length))) {
                    continue;
                }

                events.push({ pos: p, name: id });
            }

            events.sort(function (a, b) { return a.pos - b.pos; });

            for (k = 0; k < events.length; k++) {

                var cands = byName[events[k].name.toLowerCase()];
                if (!cands) { continue; }

                var target = cands[0];
                for (var q = 0; q < cands.length; q++) {
                    if (cands[q].module === m.module) { target = cands[q]; break; }
                }

                var tk = target.module + "." + target.name;
                if (seen[tk]) { continue; }
                seen[tk] = true;

                m.calls.push(target);
                target.calledBy.push(m.name);
            }
        }
    }

    /* fill the "Calls / Dependency" column */
    for (i = 0; i < macros.length; i++) {
        var names = [];
        for (j = 0; j < macros[i].calls.length; j++) {
            names.push(macros[i].calls[j].name);
        }
        var txt = "";
        if (names.length) { txt = "Calls: " + names.join(", "); }
        if (macros[i].calledBy.length) {
            txt += (txt ? " | " : "") + "Called by: " + macros[i].calledBy.join(", ");
        }
        macros[i].dependency = txt || "-";
    }

    addLog("Call analysis complete.", "success");
}


/* ---------- build the execution tree (DFS = execution order) ---------- */

function swKey(m) {
    return m.module.toLowerCase() + "." + m.name.toLowerCase();
}

function swInPath(path, key) {
    for (var i = 0; i < path.length; i++) {
        if (path[i] === key) { return true; }
    }
    return false;
}

function swNewNode(macro, parent, lane, x, isRoot, recursive) {
    return {
        macro: macro, parent: parent, lane: lane, x: x,
        kids: [], next: null, isRoot: isRoot, recursive: recursive
    };
}

function swVisit(macro, parent, lane, path, isRoot, ctx) {

    var node = swNewNode(macro, parent, lane, ctx.x++, isRoot, false);
    subwayNodes.push(node);
    ctx.n++;
    if (lane > ctx.maxLane) { ctx.maxLane = lane; }

    var newPath = path.concat([swKey(macro)]);

    if (ctx.n > 400 || path.length >= 10) { return node; }

    var kidLane = isRoot ? 0 : lane + 1;
    var calls = macro.calls || [];

    for (var i = 0; i < calls.length; i++) {

        var c = calls[i];

        if (swInPath(newPath, swKey(c))) {
            var leaf = swNewNode(c, node, kidLane, ctx.x++, false, true);
            subwayNodes.push(leaf);
            node.kids.push(leaf);
            ctx.n++;
            if (kidLane > ctx.maxLane) { ctx.maxLane = kidLane; }
        }
        else {
            node.kids.push(swVisit(c, node, kidLane, newPath, false, ctx));
        }
    }

    for (var k = 0; k < node.kids.length; k++) {
        node.kids[k].next = node.kids[k + 1] || null;
    }

    return node;
}

function buildSubway() {

    subwayRoot = null;
    subwayNodes = [];

    if (masterMacro) {
        var ctx = { x: 0, n: 0, maxLane: 0 };
        subwayRoot = swVisit(masterMacro, null, 0, [], true, ctx);
        subwayEnd = ctx.x;
        subwayMaxLane = ctx.maxLane;
    }

    renderSubway();
}


/* ---------- drawing ---------- */

function swX(x) { return SW_PADX + x * SW_XS; }
function swY(l) { return SW_PADY + l * SW_LH; }

function swFill(status) {
    var s = String(status).toLowerCase();
    if (s === "running") { return "#fde047"; }
    if (s === "completed") { return "#86efac"; }
    if (s === "failed") { return "#fca5a5"; }
    return "#ffffff";
}

function swPath(pts) {
    var d = "M" + pts[0].x + " " + pts[0].y;
    for (var i = 1; i < pts.length; i++) {
        var a = pts[i - 1];
        var b = pts[i];
        var dy = b.y - a.y;
        if (dy > 0) {          /* going down: diagonal first */
            d += " L" + (a.x + dy) + " " + b.y + " L" + b.x + " " + b.y;
        }
        else if (dy < 0) {     /* coming back up: flat first, diagonal into station */
            d += " L" + (b.x + dy) + " " + a.y + " L" + b.x + " " + b.y;
        }
        else {
            d += " L" + b.x + " " + b.y;
        }
    }
    return d;
}

function swShort(text) {
    text = String(text);
    return text.length > 17 ? text.substr(0, 16) + "\u2026" : text;
}

function renderSubway() {

    var wrap = document.getElementById("subwayWrap");
    if (!wrap) { return; }

    if (document.documentMode && document.documentMode < 9) {
        wrap.innerHTML = "<div class='empty'>This window runs in old IE compatibility mode (documentMode " +
            document.documentMode + ") and cannot draw SVG. Keep the X-UA-Compatible meta tag as the first tag inside &lt;head&gt;.</div>";
        return;
    }

    if (!subwayRoot) {
        wrap.innerHTML = "<div class='empty'>" +
            (masterMacro ? "Building map..." :
             "No Master Macro detected - the map starts from the Master Macro.") +
            "</div>";
        return;
    }

    var width = swX(subwayEnd) + SW_PADX;
    var height = swY(subwayMaxLane) + SW_PADY;
    var svg = "<svg xmlns='http://www.w3.org/2000/svg' width='" + width +
              "' height='" + height + "'>";
    var i, n, pts, color;

    /* lines */
    for (i = 0; i < subwayNodes.length; i++) {

        n = subwayNodes[i];
        if (n.kids.length === 0 && !n.isRoot) { continue; }

        pts = [{ x: swX(n.x), y: swY(n.lane) }];

        for (var k = 0; k < n.kids.length; k++) {
            pts.push({ x: swX(n.kids[k].x), y: swY(n.kids[k].lane) });
        }

        if (n.isRoot) {
            pts.push({ x: swX(subwayEnd), y: swY(0) });
            color = SW_COLORS[0];
        }
        else {
            if (n.next) { pts.push({ x: swX(n.next.x), y: swY(n.next.lane) }); }
            color = SW_COLORS[n.kids[0].lane % SW_COLORS.length];
        }

        svg += "<path d='" + swPath(pts) + "' fill='none' stroke='" + color +
               "' stroke-width='8' stroke-linecap='round' stroke-linejoin='round'/>";
    }

    /* stations */
    for (i = 0; i < subwayNodes.length; i++) {

        n = subwayNodes[i];

        var cx = swX(n.x);
        var cy = swY(n.lane);
        var lineColor = SW_COLORS[n.lane % SW_COLORS.length];
        var fill = swFill(n.macro.status);
        var label = (n.recursive ? "\u21BA " : "") + swShort(n.macro.name);
        var hasKids = n.kids.length > 0;

        if (n.isRoot) {
            svg += "<circle cx='" + cx + "' cy='" + cy + "' r='15' fill='#172033'/>" +
                   "<circle cx='" + cx + "' cy='" + cy + "' r='11' fill='" +
                   (String(n.macro.status).toLowerCase() === "ready" ? "#2563eb" : fill) + "'/>" +
                   "<text x='" + cx + "' y='" + (cy + 4) +
                   "' text-anchor='middle' font-size='10' font-weight='700' fill='#172033'>S</text>";
        }
        else {
            if (hasKids) {
                svg += "<circle cx='" + cx + "' cy='" + cy + "' r='16' fill='white' stroke='#172033' stroke-width='3'/>";
            }
            svg += "<circle cx='" + cx + "' cy='" + cy + "' r='11' fill='" + fill +
                   "' stroke='" + lineColor + "' stroke-width='4'" +
                   (n.recursive ? " stroke-dasharray='3 2'" : "") + "/>" +
                   "<text x='" + cx + "' y='" + (cy + 3.5) +
                   "' text-anchor='middle' font-size='9' font-weight='700' fill='#172033'>" +
                   i + "</text>";
        }

        svg += "<text x='" + cx + "' y='" + (cy - 26) +
               "' text-anchor='middle' font-size='11' font-weight='600' " +
               "font-family='Segoe UI, Arial, sans-serif' fill='#172033'>" +
               escapeHTML(label) + "</text>";

        if (n.isRoot) {
            svg += "<text x='" + cx + "' y='" + (cy + 32) +
                   "' text-anchor='middle' font-size='9' fill='#64748b'>START</text>";
        }
    }

    /* end terminal */
    var ex = swX(subwayEnd);
    var ey = swY(0);
    var endFill = (String(subwayRoot.macro.status).toLowerCase() === "completed") ? "#86efac" : "#ffffff";

    svg += "<circle cx='" + ex + "' cy='" + ey + "' r='15' fill='#172033'/>" +
           "<circle cx='" + ex + "' cy='" + ey + "' r='11' fill='" + endFill + "'/>" +
           "<text x='" + ex + "' y='" + (ey + 4) +
           "' text-anchor='middle' font-size='10' font-weight='700' fill='#172033'>E</text>" +
           "<text x='" + ex + "' y='" + (ey + 32) +
           "' text-anchor='middle' font-size='9' fill='#64748b'>END</text>";

    svg += "</svg>";

    wrap.innerHTML = svg;
}


/* ---------- animated replay of the execution path ---------- */

function swEvents(node, out) {
    if (node.recursive) { return; }
    out.push({ n: node, t: "in" });
    for (var i = 0; i < node.kids.length; i++) {
        swEvents(node.kids[i], out);
    }
    out.push({ n: node, t: "out" });
}

function replayExecution(preview) {

    if (!subwayRoot) {
        if (preview) {
            showAlert("No Master Macro detected - nothing to preview.", "warning");
        }
        return;
    }

    if (subwayTimer) { window.clearTimeout(subwayTimer); }

    var ev = [];
    swEvents(subwayRoot, ev);

    var idx = 0;
    var k;

    for (k = 0; k < macros.length; k++) { macros[k].status = "Pending"; }

    function step() {

        if (idx >= ev.length) {
            subwayTimer = null;
            if (preview) {
                for (k = 0; k < macros.length; k++) { macros[k].status = "Ready"; }
                addLog("Flow preview finished.", "info");
            }
            else {
                addLog("Execution path traced: " + subwayNodes.length + " stations.", "success");
            }
            renderMacros();
            updateKPIs();
            return;
        }

        var e = ev[idx++];
        e.n.macro.status = (e.t === "in") ? "Running" : "Completed";

        renderMacros();
        updateKPIs();

        subwayTimer = window.setTimeout(step, e.t === "in" ? 450 : 200);
    }

    step();
}



