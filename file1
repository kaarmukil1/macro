/* =====================================================
   EXECUTE MASTER MACRO
===================================================== */

function executeMasterMacro() {

    hideRunConfirmation();

    if (!excel || !workbook) {
        showAlert("Excel workbook is not loaded.", "error");
        return;
    }

    if (!masterMacro) {
        showAlert("Master Macro is not available.", "error");
        return;
    }

    if (automationRunning) {
        showAlert("Automation is already running.", "warning");
        return;
    }

    automationRunning = true;
    executionStart = new Date();

    resetExecution();

    document.getElementById("runButton").disabled = true;

    addLog("Starting Master Macro: " + masterMacro.name, "info");
    addTimeline("Master Macro started: " + masterMacro.name);

    try {

        var qualifiedName = "'" + workbook.Name + "'!" + masterMacro.module + "." + masterMacro.name;

        addLog("Executing: " + qualifiedName, "info");

        /* Excel COM execution. */
        excel.Run(qualifiedName);

        stopStatusPolling();

        completeAutomation();

        /* animate the execution path on the subway map */
        replayExecution(false);

    }
    catch (error) {

        stopStatusPolling();

        failAutomation(error.message);
    }
}


