<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta charset="utf-8">
<title>Macro Automation Control Center</title>

<HTA:APPLICATION
    ID="MacroAutomation"
    APPLICATIONNAME="Macro Automation Control Center"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    MAXIMIZEBUTTON="yes"
    MINIMIZEBUTTON="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="maximized"
    SCROLL="yes"
>


<style>
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; font-family: "Segoe UI", Arial, sans-serif; background: #eef2f9; color: #0f172a; }
body { overflow: hidden; }
.app { display: flex; width: 100%; height: 100vh; }

/* SIDEBAR */
.sidebar { position: relative; width: 250px; flex-shrink: 0; padding: 24px 16px; color: #fff; background: #0b1220; background-image: linear-gradient(180deg, #111c3a 0%, #0b1220 60%, #070b14 100%); box-shadow: 4px 0 24px rgba(2,6,23,0.25); }
.brand { display: flex; align-items: center; padding: 4px 8px 30px 8px; }
.brand-icon { width: 46px; height: 46px; margin-right: 12px; border-radius: 13px; font-size: 22px; display: flex; align-items: center; justify-content: center; background: #2563eb; background-image: linear-gradient(135deg, #38bdf8, #2563eb 55%, #7c3aed); box-shadow: 0 6px 18px rgba(37,99,235,0.55); }
.brand-title { font-weight: 700; font-size: 16px; letter-spacing: 0.2px; }
.brand-subtitle { color: #8da2c0; font-size: 10px; margin-top: 3px; letter-spacing: 1px; text-transform: uppercase; }
.nav-title { color: #5b6f91; font-size: 10px; font-weight: 700; padding: 8px 12px; text-transform: uppercase; letter-spacing: 1.6px; }
.nav-item { padding: 12px 14px; border-radius: 10px; color: #b6c4dc; cursor: pointer; margin-bottom: 6px; font-size: 13px; font-weight: 600; border-left: 3px solid transparent; }
.nav-item:hover { background: rgba(148,163,184,0.12); color: #fff; }
.nav-item.active { color: #fff; border-left: 3px solid #7dd3fc; background: #2563eb; background-image: linear-gradient(90deg, #2563eb, #4f46e5); box-shadow: 0 6px 16px rgba(37,99,235,0.35); }
.nav-icon { width: 26px; display: inline-block; opacity: 0.9; }
.sidebar-footer { position: absolute; bottom: 20px; left: 22px; color: #5b6f91; font-size: 10px; line-height: 1.6; }

/* MAIN */
.main { flex: 1 1 0%; min-width: 0; height: 100vh; overflow-y: auto; padding: 0 32px 44px 32px; }

/* HEADER */
.header { display: flex; justify-content: space-between; align-items: center; margin: 0 -32px 26px -32px; padding: 24px 32px; color: #fff; background: #1e3a8a; background-image: linear-gradient(120deg, #0f172a 0%, #1e3a8a 55%, #4338ca 100%); box-shadow: 0 8px 28px rgba(30,58,138,0.28); }
.header-title { font-size: 26px; font-weight: 700; letter-spacing: 0.2px; }
.header-subtitle { color: #bfd0f5; font-size: 13px; margin-top: 5px; }
.header-right { display: flex; }
.status-pill + .status-pill { margin-left: 10px; }
.status-pill { padding: 8px 15px; border-radius: 22px; background: rgba(255,255,255,0.14); color: #dbe7ff; border: 1px solid rgba(255,255,255,0.22); font-size: 11px; font-weight: 700; }
.status-pill:before { content: "\25CF  "; color: #94a3b8; }
.status-pill.green { background: rgba(34,197,94,0.20); color: #bbf7d0; border-color: rgba(74,222,128,0.5); }
.status-pill.green:before { color: #4ade80; }
.status-pill.red { background: rgba(239,68,68,0.22); color: #fecaca; border-color: rgba(248,113,113,0.5); }
.status-pill.red:before { color: #f87171; }
.status-pill.blue { background: rgba(56,189,248,0.2); color: #bae6fd; border-color: rgba(125,211,252,0.5); }
.status-pill.blue:before { color: #38bdf8; }

/* CARDS */
.card { background: #fff; border: 1px solid #e2e8f4; border-radius: 16px; padding: 22px; margin-bottom: 20px; box-shadow: 0 4px 18px rgba(15,23,42,0.06); }
.card-header { display: flex; justify-content: space-between; align-items: center; }
.card-header .btn + .btn { margin-left: 8px; }
.card-title { font-size: 16px; font-weight: 700; color: #0f172a; }
.card-description { color: #64748b; font-size: 12px; margin-top: 5px; line-height: 1.5; }

/* FILE */
.file-area { margin-top: 18px; display: flex; align-items: center; }
.file-input { display: none; }
.file-button { background: #2563eb; background-image: linear-gradient(135deg, #3b82f6, #4f46e5); color: #fff; padding: 13px 20px; border-radius: 11px; cursor: pointer; font-size: 12px; font-weight: 700; box-shadow: 0 6px 16px rgba(59,130,246,0.38); margin-right: 14px; }
.file-button:hover { background-image: linear-gradient(135deg, #2563eb, #4338ca); }
.file-information { flex: 1 1 0%; background: #f6f8fd; border: 2px dashed #c7d3ea; padding: 12px 16px; border-radius: 11px; }
.file-name { font-weight: 700; font-size: 13px; }
.file-details { color: #64748b; font-size: 11px; margin-top: 3px; }

/* KPI */
.kpi-grid { display: flex; margin-bottom: 20px; }
.kpi + .kpi { margin-left: 14px; }
.kpi { flex: 1 1 0%; background: #fff; border: 1px solid #e2e8f4; border-top: 4px solid #3b82f6; border-radius: 14px; padding: 18px; box-shadow: 0 4px 16px rgba(15,23,42,0.06); }
.kpi:nth-child(2) { border-top-color: #22c55e; }
.kpi:nth-child(3) { border-top-color: #f59e0b; }
.kpi:nth-child(4) { border-top-color: #ef4444; }
.kpi:nth-child(5) { border-top-color: #8b5cf6; }
.kpi-label { color: #64748b; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
.kpi-value { font-size: 32px; font-weight: 700; margin-top: 8px; color: #0f172a; }
.kpi-description { color: #94a3b8; font-size: 10px; margin-top: 4px; }

/* INFO */
.info-grid { display: flex; margin-bottom: 20px; }
.info-card + .info-card { margin-left: 14px; }
.info-card { flex: 1 1 0%; background: #fff; border: 1px solid #e2e8f4; border-left: 4px solid #6366f1; border-radius: 14px; padding: 16px 18px; box-shadow: 0 4px 16px rgba(15,23,42,0.05); }
.info-label { color: #64748b; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
.info-value { margin-top: 7px; font-size: 15px; font-weight: 700; color: #1e293b; }

/* BUTTONS */
.btn { border: 0; border-radius: 10px; padding: 11px 17px; cursor: pointer; font-family: "Segoe UI", Arial, sans-serif; font-size: 12px; font-weight: 700; }
.btn-primary { background: #2563eb; background-image: linear-gradient(135deg, #3b82f6, #4f46e5); color: #fff; box-shadow: 0 4px 12px rgba(59,130,246,0.35); }
.btn-success { background: #16a34a; background-image: linear-gradient(135deg, #22c55e, #15803d); color: #fff; box-shadow: 0 4px 12px rgba(34,197,94,0.35); }
.btn-danger { background: #dc2626; color: #fff; }
.btn-secondary { background: #eef2fb; color: #334155; border: 1px solid #d5dded; }
.btn-primary:hover, .btn-success:hover { opacity: 0.9; }
.btn-secondary:hover { background: #e0e8f7; }
.btn:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }

/* PROGRESS */
.progress-area { margin-top: 20px; }
.progress-top { display: flex; justify-content: space-between; font-size: 12px; font-weight: 700; color: #334155; }
.progress-track { height: 12px; background: #e6ecf7; border-radius: 12px; overflow: hidden; margin-top: 10px; }
.progress-bar { height: 100%; width: 0%; background: #2563eb; background-image: linear-gradient(90deg, #38bdf8, #4f46e5, #8b5cf6); border-radius: 12px; transition: width 0.4s ease; }

/* TABLE */
.table-container { overflow: auto; max-height: 400px; margin-top: 14px; border: 1px solid #e8edf7; border-radius: 12px; }
table { width: 100%; border-collapse: collapse; }
thead th { background: #f3f6fc; color: #64748b; font-size: 10px; font-weight: 700; padding: 12px 12px; text-align: left; letter-spacing: 1px; text-transform: uppercase; position: sticky; top: 0; }
tbody td { border-top: 1px solid #eef2f9; padding: 11px 12px; font-size: 12px; color: #1e293b; }
tbody tr:nth-child(even) { background: #fafbfe; }
tbody tr:hover { background: #eef4ff; }

/* BADGES */
.badge { display: inline-block; border-radius: 15px; padding: 5px 11px; font-size: 10px; font-weight: 700; }
.badge-ready { background: #e2e8f0; color: #475569; }
.badge-pending { background: #fef3c7; color: #92400e; }
.badge-running { background: #dbeafe; color: #1d4ed8; }
.badge-completed { background: #dcfce7; color: #166534; }
.badge-failed { background: #fee2e2; color: #991b1b; }
.badge-skipped { background: #f1f5f9; color: #64748b; }

/* TWO COLUMNS */
.two-columns { display: flex; align-items: stretch; }
.two-columns > .card:first-child { flex: 1.3 1 0%; margin-right: 20px; min-width: 0; }
.two-columns > .card:last-child { flex: 1 1 0%; min-width: 0; }

/* LOG */
.log-window { margin-top: 14px; background: #0b1220; color: #cbd5e1; border-radius: 12px; padding: 15px; height: 290px; overflow-y: auto; font-family: Consolas, monospace; font-size: 11px; border: 1px solid #1e293b; box-shadow: inset 0 2px 12px rgba(0,0,0,0.5); }
.log-line { margin-bottom: 8px; line-height: 1.5; }
.log-success { color: #86efac; }
.log-error { color: #fca5a5; }
.log-info { color: #93c5fd; }
.log-time { color: #64748b; }

/* TIMELINE */
.timeline { height: 290px; overflow-y: auto; margin-top: 14px; padding-left: 4px; }
.timeline-item { display: flex; margin-bottom: 15px; padding-left: 12px; border-left: 2px solid #dbe4f5; }
.timeline-dot { width: 11px; height: 11px; background: #2563eb; border: 2px solid #fff; box-shadow: 0 0 0 2px #93c5fd; border-radius: 50%; margin-top: 3px; margin-right: 11px; margin-left: -19px; flex-shrink: 0; }
.timeline-time { color: #64748b; font-size: 10px; font-weight: 600; }
.timeline-event { font-size: 12px; margin-top: 2px; color: #1e293b; }

/* ALERT */
.alert { display: none; border-radius: 12px; padding: 14px 16px; margin-bottom: 18px; font-size: 12px; font-weight: 600; box-shadow: 0 4px 14px rgba(15,23,42,0.08); }
.alert-error { background: #fee2e2; color: #991b1b; border-left: 5px solid #ef4444; }
.alert-success { background: #dcfce7; color: #166534; border-left: 5px solid #22c55e; }
.alert-warning { background: #fef3c7; color: #92400e; border-left: 5px solid #f59e0b; }

/* MODAL */
.modal-background { position: fixed; display: none; align-items: center; justify-content: center; left: 0; right: 0; top: 0; bottom: 0; background: rgba(8,13,28,0.68); z-index: 1000; }
.modal { background: #fff; width: 490px; border-radius: 18px; padding: 28px; border-top: 5px solid #22c55e; box-shadow: 0 30px 80px rgba(0,0,0,0.4); }
.modal-title { font-size: 20px; font-weight: 700; }
.modal-body { color: #64748b; font-size: 13px; line-height: 1.7; margin-top: 12px; }
.modal-actions { display: flex; justify-content: flex-end; margin-top: 22px; }
.modal-actions .btn + .btn { margin-left: 10px; }

.empty { text-align: center; padding: 40px; color: #94a3b8; font-size: 12px; }
.section { display: block; }

/* SUBWAY MAP */
.subway-wrap { overflow: auto; max-height: 580px; margin-top: 16px; border: 1px solid #dbe4f5; border-radius: 14px; background-color: #f8faff; background-image: linear-gradient(rgba(148,163,184,0.16) 1px, transparent 1px), linear-gradient(90deg, rgba(148,163,184,0.16) 1px, transparent 1px); background-size: 26px 26px; box-shadow: inset 0 2px 10px rgba(15,23,42,0.05); }
.sw-legend { margin-top: 14px; padding: 11px 14px; background: #f6f8fd; border-radius: 10px; font-size: 11px; color: #475569; }
.sw-legend span { display: inline-block; margin-right: 18px; }
.sw-dot { display: inline-block; width: 12px; height: 12px; border-radius: 50%; border: 2px solid #475569; vertical-align: middle; margin-right: 6px; background: #fff; }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #c3cee3; border-radius: 10px; }
.master-select { margin-top: 9px; width: 100%; padding: 7px 9px; border: 1px solid #d5dded; border-radius: 8px; font-size: 12px; font-family: "Segoe UI", Arial, sans-serif; background: #f8faff; color: #1e293b; }
</style>
</head>

<body>

<div class="app">

<!-- SIDEBAR -->
<div class="sidebar">

    <div class="brand">
        <div class="brand-icon">⚙</div>
        <div>
            <div class="brand-title">Automation Center</div>
            <div class="brand-subtitle">Excel VBA Control</div>
        </div>
    </div>

    <div class="nav-title">Workspace</div>

    <div id="navOverview" class="nav-item active" onclick="navigate('overview')"><span class="nav-icon">▦</span> Overview</div>
    <div id="navMacros" class="nav-item" onclick="navigate('macros')"><span class="nav-icon">▤</span> Macro Explorer</div>
    <div id="navRun" class="nav-item" onclick="navigate('run')"><span class="nav-icon">▶</span> Run Automation</div>
    <div id="navLogs" class="nav-item" onclick="navigate('logs')"><span class="nav-icon">≡</span> Execution Logs</div>

    <div class="sidebar-footer">
        Macro Automation Control Center<br>
        Client Edition
    </div>

</div>

<!-- MAIN -->
<div class="main">

    <!-- HEADER -->
    <div class="header">
        <div>
            <div class="header-title">Macro Automation Control Center</div>
            <div class="header-subtitle">Monitor, execute and analyze Excel-based automation</div>
        </div>
        <div class="header-right">
            <div id="excelStatus" class="status-pill">Excel Offline</div>
            <div id="workbookStatusPill" class="status-pill">No Workbook</div>
        </div>
    </div>

    <div id="alert" class="alert"></div>

    <!-- FILE SELECTION -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Select Automation Workbook</div>
                <div class="card-description">Select a macro-enabled Excel workbook (.xlsm)</div>
            </div>
            <button class="btn btn-secondary" onclick="closeExcel()">Close Excel</button>
        </div>

        <div class="file-area">
            <input type="file" id="xlsmFile" class="file-input" accept=".xlsm" onchange="workbookSelected()">
            <label for="xlsmFile" class="file-button">📁 Choose XLSM File</label>
            <div class="file-information">
                <div id="fileName" class="file-name">No workbook selected</div>
                <div id="fileDetails" class="file-details">Select an XLSM workbook to begin.</div>
            </div>
        </div>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
        <div class="kpi">
            <div class="kpi-label">TOTAL MACROS</div>
            <div id="totalMacros" class="kpi-value">0</div>
            <div class="kpi-description">Detected procedures</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">COMPLETED</div>
            <div id="completedMacros" class="kpi-value">0</div>
            <div class="kpi-description">Confirmed execution</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">RUNNING</div>
            <div id="runningMacros" class="kpi-value">0</div>
            <div class="kpi-description">Currently running</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">FAILED</div>
            <div id="failedMacros" class="kpi-value">0</div>
            <div class="kpi-description">Execution failures</div>
        </div>
        <div class="kpi">
            <div class="kpi-label">PROGRESS</div>
            <div id="progressValue" class="kpi-value">0%</div>
            <div class="kpi-description">Automation progress</div>
        </div>
    </div>

    <!-- WORKBOOK INFORMATION -->
    <div class="info-grid">
        <div class="info-card">
            <div class="info-label">MASTER MACRO</div>
            <div id="masterMacro" class="info-value">Not detected</div>
            <select id="masterSelect" class="master-select" onchange="setMaster(this.value)" style="display:none"></select>
        </div>
        <div class="info-card">
            <div class="info-label">WORKBOOK</div>
            <div id="workbookName" class="info-value">None</div>
        </div>
        <div class="info-card">
            <div class="info-label">LAST EXECUTION</div>
            <div id="lastExecution" class="info-value">None</div>
        </div>
    </div>

    <!-- EXECUTION -->
    <div class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Automation Execution</div>
                <div class="card-description">Execute the detected Master Macro</div>
            </div>
            <div>
                <button id="runButton" class="btn btn-success" disabled onclick="showRunConfirmation()">▶ Run Master Macro</button>
                <button class="btn btn-secondary" onclick="refreshWorkbook()">↻ Refresh</button>
            </div>
        </div>

        <div class="progress-area">
            <div class="progress-top">
                <span id="progressLabel">Waiting for automation</span>
                <span id="progressText">0 / 0</span>
            </div>
            <div class="progress-track">
                <div id="progressBar" class="progress-bar"></div>
            </div>
        </div>
    </div>

    <!-- SUBWAY MAP -->
    <div id="subwaySection" class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Execution Subway Map</div>
                <div class="card-description">
                    Master macro = main line. Every macro that calls child macros
                    becomes an interchange and opens a new line.
                </div>
            </div>
            <div>
                <button class="btn btn-secondary" onclick="loadDemo()">Load Demo</button>
                <button class="btn btn-secondary" onclick="buildSubway()">Rebuild Map</button>
                <button class="btn btn-primary" onclick="replayExecution(true)">&#9654; Preview Flow</button>
            </div>
        </div>

        <div id="subwayWrap" class="subway-wrap">
            <div class="empty">Open a workbook to generate the map.</div>
        </div>

        <div class="sw-legend">
            <span><i class="sw-dot"></i>Ready / Pending</span>
            <span><i class="sw-dot" style="background:#fde047"></i>Running</span>
            <span><i class="sw-dot" style="background:#86efac"></i>Completed</span>
            <span><i class="sw-dot" style="background:#fca5a5"></i>Failed</span>
            <span><i class="sw-dot" style="border-width:4px"></i>Interchange (has child macros)</span>
            <span>Numbers = execution order</span>
        </div>
    </div>

    <!-- MACRO EXPLORER -->
    <div id="macroSection" class="card">
        <div class="card-header">
            <div>
                <div class="card-title">Macro Explorer</div>
                <div class="card-description">Dynamically discovered VBA procedures</div>
            </div>
            <button class="btn btn-secondary" onclick="detectMacros()">Detect Again</button>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Macro Name</th>
                        <th>Type</th>
                        <th>Module</th>
                        <th>Status</th>
                        <th>Duration</th>
                        <th>Calls / Dependency</th>
                    </tr>
                </thead>
                <tbody id="macroTable">
                    <tr>
                        <td colspan="7"><div class="empty">No macros detected.</div></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- LOGS -->
    <div class="two-columns">

        <div id="logSection" class="card">
            <div class="card-header">
                <div>
                    <div class="card-title">Execution Log</div>
                    <div class="card-description">Real-time application events</div>
                </div>
                <button class="btn btn-secondary" onclick="clearLogs()">Clear</button>
            </div>

            <div id="logWindow" class="log-window">
                <div class="log-line">
                    <span class="log-time">[SYSTEM]</span> Dashboard initialized.
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-title">Execution Timeline</div>
            <div class="card-description">Automation events</div>
            <div id="timeline" class="timeline">
                <div class="empty">No execution events.</div>
            </div>
        </div>

    </div>

</div>
</div>

<!-- CONFIRMATION MODAL -->
<div id="confirmBackground" class="modal-background">
    <div class="modal">
        <div class="modal-title">Run Master Automation?</div>
        <div class="modal-body">
            You are about to execute:
            <br><br>
            <strong id="confirmationMacro">Master Macro</strong>
            <br><br>
            This will execute the VBA automation contained in the selected workbook.
            <br><br>
            Make sure the workbook is ready before continuing.
        </div>
        <div class="modal-actions">
            <button class="btn btn-secondary" onclick="hideRunConfirmation()">Cancel</button>
            <button class="btn btn-success" onclick="executeMasterMacro()">Run Automation</button>
        </div>
    </div>
</div>


<script language="javascript">

/* =====================================================
   GLOBAL VARIABLES
===================================================== */

var excel = null;
var workbook = null;
var workbookPath = "";
var macros = [];
var masterMacro = null;
var automationRunning = false;
var executionStart = null;
var pollingTimer = null;
var statusFile = "";
var executionHistory = [];


/* =====================================================
   INITIALIZATION
===================================================== */

window.onload = function () {
    addLog("Dashboard initialized.", "info");
    addTimeline("Dashboard initialized");
};


/* =====================================================
   FILE SELECTION
===================================================== */

function workbookSelected() {

    var input = document.getElementById("xlsmFile");

    if (!input.files || input.files.length === 0) { return; }

    var file = input.files[0];
    var path = file.path || input.value;

    if (!path) {
        showAlert("Unable to read the selected file path. Run this file as a .hta (double-click the .hta), not in Chrome/Edge.", "error");
        return;
    }

    if (path.toLowerCase().substr(path.length - 5) !== ".xlsm") {
        showAlert("Please select an .xlsm file.", "error");
        return;
    }

    workbookPath = path;

    document.getElementById("fileName").innerText = file.name;
    document.getElementById("fileDetails").innerText = "Selected • " + formatBytes(file.size);

    addLog("Workbook selected: " + file.name, "info");

    openWorkbook();
}


/* =====================================================
   OPEN WORKBOOK
===================================================== */

function openWorkbook() {

    try {

        closeExcel();

        addLog("Starting Excel...", "info");

        excel = new ActiveXObject("Excel.Application");
        excel.Visible = true;
        excel.DisplayAlerts = false;
        excel.EnableEvents = true;

        addLog("Opening workbook...", "info");

        workbook = excel.Workbooks.Open(workbookPath, false, false);

        document.getElementById("excelStatus").innerText = "Excel Connected";
        document.getElementById("excelStatus").className = "status-pill green";
        document.getElementById("workbookStatusPill").innerText = "Workbook Loaded";
        document.getElementById("workbookStatusPill").className = "status-pill green";
        document.getElementById("workbookName").innerText = workbook.Name;

        addLog("Workbook opened successfully.", "success");
        addTimeline("Workbook loaded");

        detectMacros();

    }
    catch (error) {
        showAlert("Unable to open workbook: " + error.message, "error");
        addLog("Workbook open failed: " + error.message, "error");
    }
}


/* =====================================================
   DETECT MACROS
===================================================== */

function detectMacros() {

    if (!workbook) {
        showAlert("Please select an XLSM workbook first.", "warning");
        return;
    }

    macros = [];
    masterMacro = null;

    addLog("Scanning VBA project...", "info");

    try {

        var project = workbook.VBProject;
        var components = project.VBComponents;

        for (var componentEnumerator = new Enumerator(components);
             !componentEnumerator.atEnd();
             componentEnumerator.moveNext()) {

            var component = componentEnumerator.item();
            var moduleName = component.Name;
            var moduleType = getModuleType(component.Type);
            var code = component.CodeModule;
            var lineCount = code.CountOfLines;

            if (lineCount <= 0) { continue; }

            var allLines = [];
            try {
                allLines = String(code.Lines(1, lineCount)).split(/\r?\n/);
            }
            catch (readError) {
                addLog("Could not read module " + moduleName + ": " + readError.message, "error");
                continue;
            }

            var found = 0;
            var li = 0;

            while (li < allLines.length) {

                var decl = /^\s*(?:(?:Public|Private|Friend|Static)\s+)*(Sub|Function)\s+([A-Za-z_][A-Za-z0-9_]*)/i.exec(allLines[li]);

                if (!decl) {
                    li++;
                    continue;
                }

                var procedureName = decl[2];
                var endLine = li;

                while (endLine < allLines.length - 1 &&
                       !/^\s*End\s+(Sub|Function)\b/i.test(allLines[endLine])) {
                    endLine++;
                }

                if (!macroExists(procedureName, moduleName)) {

                    macros.push({
                        name: procedureName,
                        module: moduleName,
                        type: moduleType,
                        status: "Ready",
                        duration: "-",
                        dependency: "-",
                        startTime: "",
                        endTime: "",
                        body: allLines.slice(li, endLine + 1).join("\r\n"),
                        calls: [],
                        calledBy: []
                    });

                    found++;
                }

                li = endLine + 1;
            }

            addLog("Module " + moduleName + ": " + found + " procedure(s) found.", "info");
        }

        if (macros.length === 0) {
            showAlert("No VBA procedures were detected.", "warning");
        }
        else {
            addLog("Detected " + macros.length + " VBA procedures.", "success");
        }

        try { analyzeCalls(); }
        catch (e1) { addLog("Call analysis failed: " + e1.message, "error"); }

        findMasterMacro();

        try { buildSubway(); }
        catch (e2) { addLog("Subway map failed: " + e2.message, "error"); }

        renderMacros();
        updateKPIs();

    }
    catch (error) {

        showAlert(
            "VBA project access failed. " +
            "Enable Excel: File → Options → Trust Center → Macro Settings → Trust access to the VBA project object model.",
            "error"
        );

        addLog("VBA inspection failed: " + error.message, "error");
    }
}


/* =====================================================
   MODULE TYPE
===================================================== */

function getModuleType(type) {
    if (type === 1) { return "Standard Module"; }
    if (type === 2) { return "Class Module"; }
    if (type === 3) { return "UserForm"; }
    if (type === 100) { return "Document"; }
    return "VBA Component";
}


/* =====================================================
   CHECK DUPLICATE
===================================================== */

function macroExists(name, moduleName) {
    for (var i = 0; i < macros.length; i++) {
        if (macros[i].name.toLowerCase() === name.toLowerCase() &&
            macros[i].module.toLowerCase() === moduleName.toLowerCase()) {
            return true;
        }
    }
    return false;
}


/* =====================================================
   FIND MASTER MACRO
===================================================== */

function findMasterMacro() {

    var candidates = [];
    var i;

    for (i = 0; i < macros.length; i++) {

        var name = macros[i].name.toLowerCase();
        var score = 0;

        if (name.indexOf("master") >= 0) { score += 100; }
        if (name.indexOf("automation") >= 0) { score += 80; }
        if (name === "main") { score += 70; }
        if (name.indexOf("runall") >= 0) { score += 60; }
        if (name.indexOf("run_all") >= 0) { score += 60; }

        if (score > 0) {
            candidates.push({ macro: macros[i], score: score });
        }
    }

    candidates.sort(function (a, b) { return b.score - a.score; });

    var how = "";
    masterMacro = null;

    if (candidates.length > 0) {
        masterMacro = candidates[0].macro;
        how = "by name";
    }
    else {
        /* fallback 1: top of the call tree (called by nobody, calls the most) */
        var best = null;
        for (i = 0; i < macros.length; i++) {
            var cb = macros[i].calledBy || [];
            var cl = macros[i].calls || [];
            if (cb.length === 0 && cl.length > 0 &&
                (!best || cl.length > best.calls.length)) {
                best = macros[i];
            }
        }
        if (best) {
            masterMacro = best;
            how = "top of call tree";
        }
        else if (macros.length > 0) {
            /* fallback 2: first macro found */
            masterMacro = macros[0];
            how = "first macro";
        }
    }

    populateMasterSelector();

    if (masterMacro) {

        masterMacro.status = "Ready";

        document.getElementById("masterMacro").innerText = masterMacro.name;
        document.getElementById("runButton").disabled = false;

        addLog("Master Macro identified (" + how + "): " + masterMacro.name, "success");
        addTimeline("Master Macro: " + masterMacro.name);
    }
    else {

        document.getElementById("masterMacro").innerText = "Not detected";
        document.getElementById("runButton").disabled = true;

        addLog("No macros available to use as Master Macro.", "error");
    }
}


function populateMasterSelector() {

    var select = document.getElementById("masterSelect");
    if (!select) { return; }

    select.innerHTML = "";

    if (macros.length === 0) {
        select.style.display = "none";
        return;
    }

    for (var i = 0; i < macros.length; i++) {
        var opt = document.createElement("option");
        opt.value = i;
        opt.text = macros[i].module + "." + macros[i].name;
        select.options.add(opt);
        if (macros[i] === masterMacro) { select.selectedIndex = i; }
    }

    select.style.display = "block";
}


function setMaster(index) {

    var i = parseInt(index, 10);
    if (isNaN(i) || !macros[i]) { return; }

    for (var k = 0; k < macros.length; k++) { macros[k].status = "Ready"; }

    masterMacro = macros[i];

    document.getElementById("masterMacro").innerText = masterMacro.name;
    document.getElementById("runButton").disabled = !workbook;

    addLog("Master Macro changed to: " + masterMacro.name, "info");
    addTimeline("Master Macro set: " + masterMacro.name);

    buildSubway();
    renderMacros();
    updateKPIs();
}


/* =====================================================
   RENDER MACRO TABLE
===================================================== */

function renderMacros() {

    try { renderSubway(); } catch (swError) {}

    var table = document.getElementById("macroTable");

    table.innerHTML = "";

    if (macros.length === 0) {
        table.innerHTML =
            "<tr><td colspan='7'><div class='empty'>No macros detected.</div></td></tr>";
        return;
    }

    for (var i = 0; i < macros.length; i++) {

        var macro = macros[i];
        var row = table.insertRow(-1);

        row.insertCell(0).innerText = i + 1;
        row.insertCell(1).innerText = macro.name;
        row.insertCell(2).innerText = macro.type;
        row.insertCell(3).innerText = macro.module;
        row.insertCell(4).innerHTML = createBadge(macro.status);
        row.insertCell(5).innerText = macro.duration;
        row.insertCell(6).innerText = macro.dependency;
    }
}


/* =====================================================
   STATUS BADGE
===================================================== */

function createBadge(status) {

    var css = "badge-ready";
    var normalized = String(status).toLowerCase();

    if (normalized === "pending") { css = "badge-pending"; }
    if (normalized === "running") { css = "badge-running"; }
    if (normalized === "completed") { css = "badge-completed"; }
    if (normalized === "failed") { css = "badge-failed"; }
    if (normalized === "skipped") { css = "badge-skipped"; }

    return "<span class='badge " + css + "'>" + escapeHTML(status) + "</span>";
}


