    }
}

/*
 * Reads a runtime status file created by VBA.
 * File format:  STATUS|MacroName|Status|Timestamp|Duration|Message
 */
function readRuntimeStatus() {

    if (!statusFile) { return; }

    try {

        var fso = new ActiveXObject("Scripting.FileSystemObject");

        if (!fso.FileExists(statusFile)) { return; }

        var file = fso.OpenTextFile(statusFile, 1, false);
        var content = file.ReadAll();
        file.Close();

        if (!content) { return; }

        var lines = content.split(/\r?\n/);

        for (var i = 0; i < lines.length; i++) {
            processStatusLine(lines[i]);
        }
    }
    catch (ignore) {}
}


/* =====================================================
   PROCESS STATUS
===================================================== */

function processStatusLine(line) {

    if (!line) { return; }

    var parts = line.split("|");

    if (parts.length < 3) { return; }
    if (parts[0].toUpperCase() !== "STATUS") { return; }

    var macroName = parts[1];
    var status = parts[2];
    var timestamp = parts.length > 3 ? parts[3] : "";
    var duration = parts.length > 4 ? parts[4] : "";
    var message = parts.length > 5 ? parts.slice(5).join("|") : "";

    updateMacroRuntimeStatus(macroName, status, timestamp, duration, message);
}


/* =====================================================
   UPDATE MACRO STATUS
===================================================== */

function updateMacroRuntimeStatus(macroName, status, timestamp, duration, message) {

    var found = false;

    for (var i = 0; i < macros.length; i++) {
        if (macros[i].name.toLowerCase() === macroName.toLowerCase()) {
            macros[i].status = status;
            if (duration) { macros[i].duration = duration; }
            found = true;
            break;
        }
    }

    if (!found) { return; }

    if (status.toLowerCase() === "running") {
        addLog(macroName + " started.", "info");
        addTimeline(macroName + " started");
    }

    if (status.toLowerCase() === "completed") {
        addLog(macroName + " completed." + (message ? " " + message : ""), "success");
        addTimeline(macroName + " completed");
    }

    if (status.toLowerCase() === "failed") {
        addLog(macroName + " FAILED: " + message, "error");
        addTimeline(macroName + " failed");
    }

    updateKPIs();
    renderMacros();
}


/* =====================================================
   KPI UPDATE
===================================================== */

function updateKPIs() {

    var total = macros.length;
    var completed = 0;
    var running = 0;
    var failed = 0;

    for (var i = 0; i < macros.length; i++) {
        var status = macros[i].status.toLowerCase();
        if (status === "completed") { completed++; }
        if (status === "running") { running++; }
        if (status === "failed") { failed++; }
    }

    document.getElementById("totalMacros").innerText = total;
    document.getElementById("completedMacros").innerText = completed;
    document.getElementById("runningMacros").innerText = running;
    document.getElementById("failedMacros").innerText = failed;

    var percentage = total > 0 ? Math.round((completed / total) * 100) : 0;

    document.getElementById("progressValue").innerText = percentage + "%";
    document.getElementById("progressBar").style.width = percentage + "%";
    document.getElementById("progressText").innerText = completed + " / " + total;
}


